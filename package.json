{
  "name": "zovo-oracle-sqlserver-client",
  "displayName": "Oracle SQL & SQL Server Query Client (MSSQL, T-SQL, PLSQL, Oracle Database Tool)",
  "description": "Free Oracle SQL and SQL Server client for VS Code, Cursor and Windsurf: run T-SQL and PLSQL, GO and / batches, PRINT and DBMS_OUTPUT, browse tables, cancel queries, streamed CSV export. Azure SQL, Windows (NTLM) login, tnsnames.ora, wallets. Pure JS drivers, fast start, an alternative to heavy desktop SQL tools. No sign-in, no telemetry.",
  "version": "0.1.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B2333",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Data Science",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "oracle sql",
    "sql server",
    "mssql",
    "t-sql",
    "plsql",
    "oracle database",
    "oracle client",
    "sql server client",
    "azure sql",
    "tsql",
    "oracle",
    "sql",
    "query",
    "database client",
    "database",
    "tnsnames",
    "dbms_output",
    "sql editor",
    "database explorer",
    "csv export"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Connections are stored per user, not per workspace. Nothing runs from the workspace."
    },
    "virtualWorkspaces": true
  },
