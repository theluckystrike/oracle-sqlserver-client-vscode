    "configuration": {
      "title": "Oracle & SQL Server Client",
      "properties": {
        "zovoOra.rowLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 100000,
          "description": "Rows read per query and per Load more. The rest stay on the server until you scroll or click Load more."
        },
        "zovoOra.maxLoadedRows": {
          "type": "number",
          "default": 100000,
          "minimum": 1000,
          "description": "At most this many rows stay loaded in one result. Export the result to get every row: exports stream to the file and have no limit."
        },
        "zovoOra.history": {
          "type": "boolean",
          "default": true,
          "description": "Keep the last queries per connection on this computer (VS Code global storage). Nothing is sent anywhere."
        },
        "zovoOra.historySize": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 5000,
          "description": "Queries kept in the history of each connection."
        },
        "zovoOra.confirmUnboundedWrites": {
          "type": "boolean",
          "default": true,
          "description": "Ask before UPDATE or DELETE without WHERE, TRUNCATE or DROP runs."
        },
        "zovoOra.connectTimeoutSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 120,
          "description": "Give up connecting after this many seconds, with a clear message instead of a hang."
        },
        "zovoOra.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a Marketplace rating after 2 good sessions at least 4 hours apart. \"Later\" asks once more after 7 days, \"No thanks\" never asks again. Never after an error. Nothing is sent anywhere."
        },
        "zovoOra.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor, PayPal and More free tools links in the results status line. Nothing is sent anywhere."
        },
        "zovoOra.showProFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Show the Zovo Pro tools (execution plan, schema compare, ER diagram, schema DDL export, query library) in menus and the command palette. Set it to false to hide them. Everything free keeps working."
        },
        "zovoOra.oracleDbmsOutput": {
          "type": "boolean",
          "default": true,
          "description": "Oracle: turn on DBMS_OUTPUT for each new session and show PUT_LINE output in the Messages tab. \"SET SERVEROUTPUT ON/OFF\" lines in a script also switch it."
        },
        "zovoOra.oracleAutoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Oracle: commit each statement when it succeeds. Turn it off to COMMIT or ROLLBACK yourself (uncommitted changes are rolled back when the connection closes)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "zovoOra.start",
        "title": "Get started with Oracle SQL & SQL Server",
        "description": "Connect to SQL Server, Azure SQL or Oracle, run T-SQL and PLSQL, and export results. Free, no sign-in.",
        "steps": [
          {
            "id": "connect",
            "title": "Add a connection",
            "description": "Paste a connection string (ADO.NET, JDBC, sqlserver:// or an Oracle Easy Connect string), or fill in the form. SQL login, Windows (NTLM), Azure AD token, tnsnames.ora aliases and wallets. The password goes to VS Code's secret storage.\n[Add Connection](command:zovoOra.addConnection)",
            "media": {
              "markdown": "walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:zovoOra.addConnection"
            ]
          },
          {
            "id": "query",
            "title": "Run a query",
            "description": "Click New Query on a connection. Ctrl+Enter (Cmd+Enter on macOS) runs the statement or GO batch at the cursor; Ctrl+Alt+Enter runs the whole file. PRINT and DBMS_OUTPUT lines show in Messages. Cancel stops a long query on the server.\n[New Query](command:zovoOra.newQuery)",
            "media": {
              "image": "images/screenshot-dark.png",
              "altText": "A T-SQL batch in the editor with two result sets and PRINT messages next to it, and the explorer with SQL Server and Oracle connections on the left."
            },
            "completionEvents": [
              "onCommand:zovoOra.newQuery",
              "onCommand:zovoOra.runStatement"
            ]
          },
          {
            "id": "edit",
            "title": "Export and stay safe",
            "description": "Export streams every row to CSV, JSON or SQL INSERT. Read-only connections are enforced by the server. UPDATE or DELETE without WHERE, TRUNCATE and DROP ask first.",
            "media": {
              "markdown": "walkthrough/edit.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js --production",
    "test": "node scripts/build.js --production && ZOVO_SPONSORS_MODULE=$PWD/src/license/sponsors.js node --test \"test/*.test.js\"",
    "package": "node scripts/build.js --production && npx -y @vscode/vsce package --no-dependencies -o dist/ && node scripts/check-vsix.js dist/zovo-oracle-sqlserver-client-0.1.0.vsix",
    "test:it": "ZOVO_SQL_IT=1 node --test --test-concurrency=1 test/integration.test.js"
  },
